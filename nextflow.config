/*
 * HaploSync Nextflow Configuration
 */

manifest {
    name            = 'noecochetel/haplosync'
    contributors    = [
        [
            name: 'Noe Cochetel',
            affiliation: '',
            email: '',
            github: 'noecochetel',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/noecochetel/HaploSync'
    description     = 'Haplotype-resolved pseudomolecule assembly and gap-filling pipeline'
    mainScript      = 'main.nf'
    defaultBranch   = 'nextflow-port'
    nextflowVersion = '>=25.04.0' // required by the nf-schema plugin
    version         = '2.0.0dev'
    doi             = ''
}

// --------------------------------------------------------------------------
// Default parameters
// --------------------------------------------------------------------------
params {
    help            = false  // Print help message and exit
    monochrome_logs = false  // Disable ANSI console output styling

    // --- Pipeline stage ---
    step            = 'reconstruct_pm'  // reconstruct_pm (default) | gap_fill

    // --- Required inputs ---
    // Provide (markers AND markers_map) and/or guide_genome
    input_fasta     = null   // Draft assembly FASTA (-i)

    // --- Genetic map ---
    markers         = null   // Marker hits BED file (-n)
    markers_map     = null   // Markers genetic map (-m)

    // --- Reference genome ---
    guide_genome    = null   // Guide/reference genome FASTA (-g/--guide)
    local_alignment = null   // Existing PAF file, skips minimap2 (-l)
    run_alignment   = false  // Run minimap2 alignment (--align)
    mapping_tool    = '--cs -x asm20 -r 1000' // Minimap2 options string (-t)
    hitgap          = 100000 // Max gap between alignment hits in bp (--hitgap)
    distance1       = 2000000 // Max Hap1 adjacency distance in bp (--distance1)
    distance2       = 4000000 // Max Hap2 adjacency distance in bp (--distance2)
    reuse_intermediate = false // Reuse nucmer intermediate files (--reuse_intermediate)

    // --- Optional inputs ---
    input_agp       = null   // Input AGP structure (-a)
    gff3            = null   // Gene annotation GFF3 (--GFF3)
    exclusion       = null   // Mutually exclusive sequence pairs (-e)
    known           = null   // Known same-haplotype sequences (-k)
    alternative_groups = null // Alternative haplotype sequence pairs
    Require1        = null   // Sequences required in Hap1 (--R1)
    Require2        = null   // Sequences required in Hap2 (--R2)
    force_direction1 = false // Force marker direction for --R1 (--F1)
    force_direction2 = false // Force marker direction for --R2 (--F2)
    minR1           = null   // Minimum length for --R1 sequences
    minR2           = null   // Minimum length for --R2 sequences
    Blacklist1      = null   // Blacklisted sequences for Hap1 (--B1)
    Blacklist2      = null   // Blacklisted sequences for Hap2 (--B2)
    input_groups    = null   // Sequence grouping file (--input_groups)
    legacy_groups   = null   // Legacy component group file (--legacy_groups)
    path1           = null   // Pre-defined Hap1 tiling path file (-1/--path1)
    path2           = null   // Pre-defined Hap2 tiling path file (-2/--path2)

    // --- Assembly behaviour ---
    No2             = false  // Skip Hap2 reconstruction (--N2)
    gap             = 1000   // Gap size in bp (--gapsize)
    conc            = null   // Concatenate unplaced sequences with this gap size (--concatenate)
    filter_hits     = false  // Remove sequences with intra-sequence marker duplication (-f)
    extended_region = false  // Extend sequence association to all chromosome markers (--extended)
    conflict_resolution = null // Conflict resolution policy: exit | ignore | release (--conflict)
    allow_rearrangements = false // Allow rearrangements between haplotypes (--allow_rearrangements)
    required_as_path    = false  // Treat --R1/--R2 as full tiling paths (--required_as_path)

    // --- QC ---
    skip_chimeric_qc = false            // Skip chimeric sequence QC (--skip_chimeric_qc)
    disable_marker_ploidy_check = false // Disable marker ploidy check (--disable_marker_ploidy_check)
    only_markers        = false         // Limit rejected-seq QC to marker-bearing seqs (--only_markers)
    avoid_rejected_qc   = false         // Skip QC of chr-assigned but unplaced seqs (--avoid_rejected_qc)
    skip_chr_pair_reports = false       // Skip per-chromosome pair overview reports
    skip_unplaced_qc    = false         // Skip unplaced sequence QC reports

    // --- Output ---
    out             = 'out'
    prefix          = 'NEW'
    outdir          = 'results'
    trace_timestamp = new java.text.SimpleDateFormat("yyyy-MM-dd_HH-mm-ss").format(new Date()) // Suffix for execution report filenames

    // --- Resources ---
    cores           = 4

    // --- Extra flags ---
    haplodup_opts     = ''   // Extra HaploDup flags as a quoted string

    // --- HaploDup ---
    run_haplodup    = false  // Run HaploDup after reconstruction

    // Optional inputs
    reference                = null   // Reference genome for dotplots (-r)
    functional_annotation    = null   // Functional annotation per transcript (-a)

    // Alignment thresholds
    hit_identity             = 90     // Min genome mapping identity     (--hit_identity)
    hit_coverage             = 3000   // Min genome mapping hit length   (--hit_coverage)
    gene_identity            = 95     // Min gene mapping identity       (--gene_identity)
    gene_coverage            = 95     // Min gene mapping coverage       (--gene_coverage)
    unbalanced_ratio         = 0.33   // Gene count ratio threshold      (--unbalanced_ratio)

    // Gene mapping
    haplodup_feature         = 'CDS'  // GFF feature type [CDS|mRNA]     (--feature)
    haplodup_window          = 10     // Window size for unbalanced gene search (--window)
    haplodup_allowed         = 5      // Allowed unbalanced genes/window  (--allowed)

    // Reuse / skip
    reuse_mappings           = false  // Reuse existing genome alignments (--reuse_mappings)
    reuse_dotplots           = false  // Reuse existing dotplots          (--reuse_dotplots)
    reuse_gmap               = false  // Reuse existing GMAP mappings     (--reuse_gmap)
    skip_dotplots_by_chr     = false  // Skip individual chr-vs-chr dotplots (--skip_dotplots_by_chr)
    only_paired_dotplots     = false  // Only generate matched-pair dotplots (--only_paired_dotplots)

    // --------------------------------------------------------------------------
    // HaploFill / HaploMake / gap_fill.nf
    // --------------------------------------------------------------------------

    // Required inputs (set via params file or CLI)
    hapfill_hap1            = null   // Hap1 FASTA
    hapfill_hap2            = null   // Hap2 FASTA
    hapfill_unplaced        = null   // Unplaced sequences FASTA (optional)
    hapfill_correspondence  = null   // Chromosome correspondence TSV
    hapfill_repeats         = null   // Repeats file
    hapfill_b1              = null   // BAM aligned to Hap1
    hapfill_b2              = null   // BAM aligned to Hap2

    // HaploFill options
    hapfill_repeats_format  = 'BED'  // Repeats file format (GFF3|BED)
    hapfill_coverage        = null   // Per-base coverage threshold (default: auto)
    hapfill_flanking        = null   // Flanking region size in bp  (default: auto)
    hapfill_map_threads     = 4      // Threads for minimap2
    hapfill_nohomozygous    = false  // Skip homozygous gap filling
    hapfill_overwrite       = false  // Overwrite existing temp folder
    hapfill_exclusion       = null   // Mutually exclusive sequence pairs
    hapfill_known           = null   // Sequences known to be in same haplotype

    // Coverage tool
    coverage_tool           = 'bedtools'  // bedtools (default) | mosdepth (faster)

    // HaploMake
    run_haplomake           = false  // Build new FASTA/AGP from gap-fill result
    hapmake_prefix          = null   // Sequence ID prefix
    hapmake_agp             = null   // AGP for legacy coordinate mapping
    hapmake_gff3            = null   // Gene annotation GFF3 to translate
    hapmake_bed             = null   // BED file to translate
    hapmake_gap             = 1000   // Gap size in bp
    hapmake_noagp           = false  // Skip AGP output
    hapmake_legacy_agp      = null   // Deeper legacy AGP (e.g. pre-HaploSplit contigs), ported via a second --noprint-only pass
}

// Resource labels moved to conf/base.config
includeConfig 'conf/base.config'

// Auto-confirm conda/mamba env creation (newer mamba prompts even for `env create`,
// which hangs forever since Nextflow runs it non-interactively)
conda {
    createOptions = '-y'
}

// --------------------------------------------------------------------------
// Execution reports
// --------------------------------------------------------------------------
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_timestamp}.html"
}

// --------------------------------------------------------------------------
// Execution profiles
// --------------------------------------------------------------------------
profiles {

    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled  = true
        conda.useMamba = false
    }

    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }

    test_reconstructpm { includeConfig 'conf/test_reconstructpm.config' }
    test_gapfill       { includeConfig 'conf/test_gapfill.config' }
    test_full          { includeConfig 'conf/test_full.config' }
}

// --------------------------------------------------------------------------
// Nextflow plugins
// --------------------------------------------------------------------------
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters against nextflow_schema.json
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
