# Ignore everything by default
*

# Allow directories to be explored
!*/

# Re-ignore private/unwanted directories
.obsidian/
private_dev/
.Rproj.user/
__pycache__/

# Root-level files
!/*.md
!/*.Rproj
!/.gitignore
!/.gitattributes
!/.prettierignore
!/.prettierrc.yml
!/.nf-core.yml
!/main.nf
!/nextflow.config
!/nextflow_schema.json
!/nf-test.config
!/HaploSync.conf.toml
!/LICENSE
!/modules.json

# Tracked directories
!documents/
!documents/**
!media/
!media/**
!support_scripts/
!support_scripts/**
!nextflow/
!nextflow/**
!archives/
!archives/**
!bin/
!bin/**
!conf/
!conf/**
!workflows/
!workflows/**
!subworkflows/
!subworkflows/**
!docs/
!docs/**
!tests/
!tests/**
!test_data/
!test_data/**
!.github/
!.github/**
!assets/
!assets/**
!modules/
!modules/**

# nf-core / Nextflow run artifacts
.nextflow*
work/
.lineage/

# Exclude generated/temporary files even inside tracked directories
# (these rules come last to override the directory includes above)
*.pyc
**/.DS_Store
.DS_Store
