/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    HaploSync doesn't have a larger public test dataset (real genome assemblies
    are far too large to bundle or fetch in CI), so this profile intentionally
    mirrors conf/test.config rather than fabricating a "full-size" run.

    Use as follows:
        nextflow run . -profile test_full,<conda/mamba> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'
