/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Each local module under nextflow/modules/local/ already declares its own
    explicit publishDir (e.g. "${params.outdir}/HaploSplit"), so no generic
    override is defined here. Add per-process configuration blocks here
    as needed.
----------------------------------------------------------------------------------------
*/

process {
    // HF_COVERAGE is scattered one job per chromosome. It inherits
    // 'process_high' (24 cpus / 64GB) by default, which is appropriate for
    // bedtools (RAM-heavy on large chromosomes) but wastes most of that
    // reservation when --coverage_tool mosdepth is used (mosdepth needs only
    // a couple cores and a few hundred MB per chromosome). On a node with
    // fewer than ~48 cores, the flat 'process_high' request caps concurrency
    // at 1-2 jobs regardless of how little mosdepth actually uses. Scale
    // down only for mosdepth.
    withName: 'HF_COVERAGE' {
        cpus   = { params.coverage_tool == 'mosdepth' ? 2      : 24 }
        memory = { params.coverage_tool == 'mosdepth' ? '4.GB' : '64.GB' }
    }

    // HF_PLOIDY's STEP 3.1 (per-chromosome coverage smoothing) is now
    // parallelized across --processes worker processes (wired to task.cpus
    // in hapfill_ploidy/main.nf). It inherits 'process_medium' (8 cpus/32GB)
    // by default, which caps parallelism well below what a typical node can
    // offer. Bump cpus so more chromosomes are smoothed concurrently.
    withName: 'HF_PLOIDY' {
        cpus   = 24
        memory = '48.GB'
    }
}
