/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple
    pipeline test for --step gap_fill, using a fixed fixture (the verified
    output of conf/test.config's reconstruct_pm run) rather than chaining a
    live run — gap_fill always follows a manual-curation step that CI can't
    perform, so this profile tests the stage in isolation against static
    fixture files, the same pattern nf-core/sarek uses for its own staged
    --step reruns.

    Use as follows:
        nextflow run . -profile test_gapfill,<conda/mamba> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile (gap_fill)'
    config_profile_description = 'Minimal test dataset to check gap_fill functionality'

    step                    = 'gap_fill'
    hapfill_hap1            = "${projectDir}/test_data/gap_fill_fixtures/pm01.1.fasta"
    hapfill_hap2            = "${projectDir}/test_data/gap_fill_fixtures/pm01.2.fasta"
    hapfill_correspondence  = "${projectDir}/test_data/gap_fill_fixtures/pm01.correspondence.tsv"
    hapfill_unplaced        = "${projectDir}/test_data/gap_fill_fixtures/pm01.Un.fasta"
    hapfill_repeats         = "${projectDir}/test_data/repeats.empty.bed"
    hapfill_repeats_format  = 'BED'
    hapfill_b1              = "${projectDir}/test_data/gap_fill_fixtures/hap1.on.hap1.sorted.bam"
    hapfill_b2              = "${projectDir}/test_data/gap_fill_fixtures/hap2.on.hap2.sorted.bam"
    hapfill_map_threads     = 2
    hapfill_nohomozygous    = false
    run_haplomake           = true
    hapmake_gff3            = "${projectDir}/test_data/gap_fill_fixtures/genes.gff3"
    hapmake_bed             = "${projectDir}/test_data/gap_fill_fixtures/markers.bed"
    out                     = 'gf01'
    outdir                  = 'results_gf'
    cores                   = 2
}
