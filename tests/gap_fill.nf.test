nextflow_pipeline {

    name "Test --step gap_fill"
    script "../main.nf"
    tag "pipeline"
    tag "gap_fill"

    test("gap_fill against the reconstruct_pm fixture output") {

        when {
            params {
                // Mirrors conf/test_gapfill.config inline (see that file for why
                // gap_fill is tested against a static fixture rather than a live
                // chained run), rather than relying on -profile combination
                // behaviour - this test only needs an executor profile
                // (conda/standard) passed on the nf-test CLI.
                step                    = 'gap_fill'
                hapfill_hap1            = "$projectDir/test_data/gap_fill_fixtures/pm01.1.fasta"
                hapfill_hap2            = "$projectDir/test_data/gap_fill_fixtures/pm01.2.fasta"
                hapfill_correspondence  = "$projectDir/test_data/gap_fill_fixtures/pm01.correspondence.tsv"
                hapfill_unplaced        = "$projectDir/test_data/gap_fill_fixtures/pm01.Un.fasta"
                hapfill_repeats         = "$projectDir/test_data/repeats.empty.bed"
                hapfill_repeats_format  = 'BED'
                hapfill_b1              = "$projectDir/test_data/gap_fill_fixtures/hap1.on.hap1.sorted.bam"
                hapfill_b2              = "$projectDir/test_data/gap_fill_fixtures/hap2.on.hap2.sorted.bam"
                hapfill_map_threads     = 2
                hapfill_nohomozygous    = false
                run_haplomake           = true
                out                     = 'gf01'
                outdir                  = "$outputDir"
                cores                   = 2
            }
        }

        then {
            assert workflow.success

            def gapFillingFindings = path("$outputDir/HaploFill/gf01.gap_filling_findings.txt").text
            assert gapFillingFindings.contains("Gap 2")

            // The deliberately-injected gap on TEST_Hap1_chr1 sits at pseudomolecule
            // offset 5700-6000 pre-fill. HaploMake rebuilds the assembly with fresh
            // 1000bp join gaps between every component (the only behaviour now that
            // dodge_overlaps/--skipoverlap has been retired), so
            // the filled 300bp segment ends up at offset 6700-7000 in the final
            // FASTA - it must contain no N's and match the true hap2 mate sequence
            // (true chr1[4700:5000]) that HaploFill pulled in as the homozygous filler.
            def finalFasta = path("$outputDir/HaploMake/gf01.fasta").text
            def hap1Record = finalFasta.split(">").find { it.startsWith("TEST_Hap1_chr1") }
            def hap1Seq = hap1Record.readLines().drop(1).join("")
            def filledRegion = hap1Seq.substring(6700, 7000)
            assert !filledRegion.contains("N")

            def trueHap2Fasta = new File("test_data/true_hap2.fasta").text
            def trueHap2Chr1 = trueHap2Fasta.split(">").find { it.startsWith("chr1") }.readLines().drop(1).join("")
            assert filledRegion == trueHap2Chr1.substring(4700, 5000)

            // A second, independent gap was introduced at the same locus in
            // BOTH TEST_Hap1_chr3 and TEST_Hap2_chr3 (a dedicated 20000bp
            // chromosome - see test_data/add_gap_fill_contig_scenario.py),
            // together with a genuine unplaced contig (TEST_Un_chr3_filler)
            // built from Hap1's own true sequence. Unlike the chr1 gap above
            // (resolved via the homozygous fallback), this exercises
            // HaploFill's main contig-search mechanism (STEP 6.2/6.3).
            // remove_ids_from_pass() only assigns one physical contig to one
            // gap position, so with a single filler contig and two
            // homologous gap copies, exactly one is filled and the other
            // legitimately stays open - that's expected, not a bug. Since
            // the filler is built from Hap1's own true sequence while Hap2's
            // copy carries mutate()'s substitutions, it's Hap1's gap that
            // gets filled (confirmed via gap_filling_findings.txt: Gap 3
            // targets TEST_Hap1_chr3, Gap 4 targets TEST_Hap2_chr3 with no
            // match found).
            assert gapFillingFindings.contains("TEST_Un_chr3_filler")

            def trueHap1Fasta = new File("test_data/true_hap1.fasta").text
            def trueHap1Chr3 = trueHap1Fasta.split(">").find { it.startsWith("chr3") }.readLines().drop(1).join("")
            // TEST_Un_chr3_filler is exactly hap1_chr3[9150:10850) (700bp
            // flank either side of the true [9850,10150) gap - see FLANK in
            // add_gap_fill_contig_scenario.py).
            def trueFillerContig = trueHap1Chr3.substring(9150, 10850)

            def hap1Chr3Record = finalFasta.split(">").find { it.startsWith("TEST_Hap1_chr3") }
            def hap1Chr3Seq = hap1Chr3Record.readLines().drop(1).join("")

            // HaploFill reconstructs this region from aligned reads carrying
            // simulated sequencing noise (error_rate=0.005 in
            // add_gap_fill_contig_scenario.py), so the exact consensus base
            // call at a handful of positions can legitimately differ by
            // environment/aligner version, even though the fill is correct.
            // Check percent identity of the best-aligning window rather than
            // requiring an exact substring match - genuine DNA is
            // effectively random here, so only the true fill site can ever
            // score anywhere near the 99% threshold.
            def probeLen = trueFillerContig.length()
            def bestMismatches = probeLen + 1
            for (int offset = 0; offset <= hap1Chr3Seq.length() - probeLen; offset++) {
                int mismatches = 0
                for (int i = 0; i < probeLen; i++) {
                    if (hap1Chr3Seq.charAt(offset + i) != trueFillerContig.charAt(i)) {
                        mismatches++
                        if (mismatches >= bestMismatches) break
                    }
                }
                if (mismatches < bestMismatches) bestMismatches = mismatches
            }
            def bestIdentity = 1.0 - (bestMismatches / (double) probeLen)
            assert bestIdentity >= 0.99

            def hap2Chr3Record = finalFasta.split(">").find { it.startsWith("TEST_Hap2_chr3") }
            def hap2Chr3Seq = hap2Chr3Record.readLines().drop(1).join("")
            def trueGapContentChr3 = trueHap1Chr3.substring(9850, 10150)
            assert !hap2Chr3Seq.contains(trueGapContentChr3)
        }
    }
}
