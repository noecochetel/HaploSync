nextflow_pipeline {

    name "Test --step gap_fill"
    script "../main.nf"
    tag "pipeline"
    tag "gap_fill"

    test("gap_fill against the reconstruct_pm fixture output") {

        when {
            params {
                // Mirrors conf/test_gapfill.config inline (see that file for why
                // gap_fill is tested against a static fixture rather than a live
                // chained run), rather than relying on -profile combination
                // behaviour - this test only needs an executor profile
                // (conda/standard) passed on the nf-test CLI.
                step                    = 'gap_fill'
                hapfill_hap1            = "$projectDir/test_data/gap_fill_fixtures/pm01.1.fasta"
                hapfill_hap2            = "$projectDir/test_data/gap_fill_fixtures/pm01.2.fasta"
                hapfill_correspondence  = "$projectDir/test_data/gap_fill_fixtures/pm01.correspondence.tsv"
                hapfill_unplaced        = "$projectDir/test_data/gap_fill_fixtures/pm01.Un.fasta"
                hapfill_repeats         = "$projectDir/test_data/repeats.empty.bed"
                hapfill_repeats_format  = 'BED'
                hapfill_b1              = "$projectDir/test_data/gap_fill_fixtures/hap1.on.hap1.sorted.bam"
                hapfill_b2              = "$projectDir/test_data/gap_fill_fixtures/hap2.on.hap2.sorted.bam"
                hapfill_map_threads     = 2
                hapfill_nohomozygous    = false
                run_haplomake           = true
                out                     = 'gf01'
                outdir                  = "$outputDir"
                cores                   = 2
            }
        }

        then {
            assert workflow.success

            def gapFillingFindings = path("$outputDir/HaploFill/gf01.gap_filling_findings.txt").text
            assert gapFillingFindings.contains("Gap 2")

            // The deliberately-injected gap on TEST_Hap1_chr1 sits at pseudomolecule
            // offset 5700-6000 pre-fill. HaploMake rebuilds the assembly with fresh
            // 1000bp join gaps between every component (the only behaviour now that
            // dodge_overlaps/--skipoverlap has been retired), so
            // the filled 300bp segment ends up at offset 6700-7000 in the final
            // FASTA - it must contain no N's and match the true hap2 mate sequence
            // (true chr1[4700:5000]) that HaploFill pulled in as the homozygous filler.
            def finalFasta = path("$outputDir/HaploMake/gf01.fasta").text
            def hap1Record = finalFasta.split(">").find { it.startsWith("TEST_Hap1_chr1") }
            def hap1Seq = hap1Record.readLines().drop(1).join("")
            def filledRegion = hap1Seq.substring(6700, 7000)
            assert !filledRegion.contains("N")

            def trueHap2Fasta = new File("test_data/true_hap2.fasta").text
            def trueHap2Chr1 = trueHap2Fasta.split(">").find { it.startsWith("chr1") }.readLines().drop(1).join("")
            assert filledRegion == trueHap2Chr1.substring(4700, 5000)

            // A second, independent gap was introduced in TEST_Hap1_chr3 only
            // (a dedicated 20000bp chromosome - see
            // test_data/add_gap_fill_contig_scenario.py), together with a
            // genuine unplaced contig (TEST_Un_chr3_filler) built from Hap1's
            // own true sequence. Unlike the chr1 gap above (resolved via the
            // homozygous fallback), this exercises HaploFill's main
            // contig-search mechanism (STEP 6.2/6.3). Hap2 is deliberately
            // left ungapped at the corresponding locus: an earlier version of
            // this fixture gapped both haplotypes there, which created a
            // second, near-duplicate gap descriptor (Hap2's own gap, whose
            // "alternative allele" reconstruction pulls in Hap1's own clean
            // flanks) competing for the same filler contig - a genuine tie
            // decided by a 1-2bp nucmer alignment-extension margin that isn't
            // stable across environments. With only one gap in play there is
            // only one candidate, so the fill is deterministic.
            assert gapFillingFindings.contains("TEST_Un_chr3_filler")

            // Verify the pipelines own structural decision for this gap
            // (which target, which contig, which strand), redundantly with
            // the exact final-assembly check below. The matched length isn't
            // asserted precisely since Hap2's homologous region is spliced in
            // as a supplementary search target under this strategy, and its
            // exact contribution isn't load-bearing for correctness.
            def gap3Block = gapFillingFindings.split("> Gap ").find { it.trim().startsWith("3") }
            assert gap3Block != null
            def gap3Lines = gap3Block.readLines()
            assert gap3Lines.find { it.contains("Sequence id") }?.contains("TEST_Hap1_chr3")
            assert gap3Lines.find { it.contains("T1_best_match") && !it.contains("_len") && !it.contains("_strand") }?.contains("TEST_Un_chr3_filler")
            assert gap3Lines.find { it.contains("T1_best_match_strand") }?.trim()?.endsWith(":+")

            // HaploMake (--skipoverlap, the only mode now that dodge_overlaps
            // has been retired) does not splice components together - it
            // injects a fresh 1000bp gap on each side of every join,
            // including around a HaploFill-placed filler. That is expected,
            // documented behavior (matches the chr1 case above, and the
            // hapmake.md/gap_fill.md docs), not something to work around.
            // For Hap1: [0,9850) original prefix, 1000bp gap, the filler
            // itself (byte-exact - this part is a straight copy, not a
            // read-based reconstruction, so no identity tolerance is
            // needed), 1000bp gap, [10150,20000) original suffix.
            def trueHap1Fasta = new File("test_data/true_hap1.fasta").text
            def trueHap1Chr3 = trueHap1Fasta.split(">").find { it.startsWith("chr3") }.readLines().drop(1).join("")

            def hap1Chr3Record = finalFasta.split(">").find { it.startsWith("TEST_Hap1_chr3") }
            def hap1Chr3Seq = hap1Chr3Record.readLines().drop(1).join("")
            assert hap1Chr3Seq.length() == 23400
            assert hap1Chr3Seq.substring(0, 9850) == trueHap1Chr3.substring(0, 9850)
            assert hap1Chr3Seq.substring(9850, 10850) == "N" * 1000
            assert hap1Chr3Seq.substring(10850, 12550) == trueHap1Chr3.substring(9150, 10850)
            assert hap1Chr3Seq.substring(12550, 13550) == "N" * 1000
            assert hap1Chr3Seq.substring(13550, 23400) == trueHap1Chr3.substring(10150, 20000)

            // Hap2 was never gapped at this locus, so it has nothing to fill
            // and no join to make - it passes straight through as a single,
            // untouched component, byte-identical to its own true sequence.
            def trueHap2Chr3 = trueHap2Fasta.split(">").find { it.startsWith("chr3") }.readLines().drop(1).join("")

            def hap2Chr3Record = finalFasta.split(">").find { it.startsWith("TEST_Hap2_chr3") }
            def hap2Chr3Seq = hap2Chr3Record.readLines().drop(1).join("")
            assert hap2Chr3Seq == trueHap2Chr3
        }
    }
}
