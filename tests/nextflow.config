/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
    HaploSync's test data is bundled locally under test_data/ (see conf/test.config,
    conf/test_gapfill.config) rather than fetched from an external test-datasets repo.
*/

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

// GitHub-hosted CI runners (ubuntu-latest) only have 2 CPUs - cap process_high's
// 24 cpus / 64 GB (tuned for real genome assemblies, see conf/base.config) down
// to something that fits both CI and a laptop for this tiny synthetic test genome.
process {
    withLabel: 'process_low'    { cpus = 2; memory = '2.GB' }
    withLabel: 'process_medium' { cpus = 2; memory = '2.GB' }
    withLabel: 'process_high'   { cpus = 4; memory = '4.GB' }
}
